# ============================================================
# CONFIGURACAO DOCKER - Benchmark VectorDB
# Otimizado para maquina com 128GB RAM
# Total alocado para containers: ~108GB (36GB cada)
# Margem para sistema host: ~20GB
# ============================================================

# -----------------------------------------------------------
# POSTGRESQL / PGVECTOR - 36GB
# shared_buffers=24GB + maintenance_work_mem=8GB + overhead
# -----------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=psql_jurisprudencia
POSTGRES_PORT=5434

# Memoria e CPUs para PostgreSQL
PG_MEM_LIMIT=36g
PG_CPUS=16
PG_WORK_MEM=64MB

# -----------------------------------------------------------
# ELASTICSEARCH - 36GB
# Heap Java=32GB (hardcoded no docker-compose.yml) + Sistema/Cache=4GB
# NOTA: O heap JVM esta fixo em 32GB no compose original
# -----------------------------------------------------------
ES_HTTP_PORT=9201

# Memoria e CPUs para Elasticsearch
ES_MEM_LIMIT=36g
BENCH_CPUS_ES_OS=16

# -----------------------------------------------------------
# OPENSEARCH - 36GB
# Heap Java=32GB (hardcoded no docker-compose.yml) + Sistema/Cache=4GB
# NOTA: O heap JVM esta fixo em 32GB no compose original
# -----------------------------------------------------------
OS_HTTP_PORT=9200
OS_TRANSPORT_PORT=9600

# Memoria e CPUs para OpenSearch
OS_MEM_LIMIT=36g

# -----------------------------------------------------------
# RESUMO DE ALOCACAO (128GB total)
# -----------------------------------------------------------
# PostgreSQL:     36GB
# Elasticsearch:  36GB
# OpenSearch:     36GB
# -----------------------
# Containers:    108GB
# Host/Sistema:   20GB (margem segura)
# -----------------------------------------------------------
#
# AJUSTES POR DATASET:
# - 50K, 500K, 1M: Esta configuracao e mais que suficiente
# - 10M: Funciona bem com maintenance_work_mem=32GB no pgvector
# 
# Se precisar rodar 10M com maintenance_work_mem=64GB:
#   Aumente PG_MEM_LIMIT para 42g ou mais
#
# NOTA SOBRE VALORES HARDCODED NO docker-compose.yml:
# - ES_JAVA_OPTS: "-Xms32g -Xmx32g" (heap JVM fixo)
# - OPENSEARCH_JAVA_OPTS: "-Xms32g -Xmx32g" (heap JVM fixo)
# - shared_buffers=16GB (PostgreSQL - pode ser sobrescrito via command)
# - shm_size: 18g (shared memory do PostgreSQL)
#
# Para ajustar heap JVM, edite o docker-compose.yml do banco-de-dados-jurisprudencia
# ou crie um docker-compose.override.yml neste diretorio.
# -----------------------------------------------------------
