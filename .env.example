# Configuração de Ambiente para VectorDBBench
# Copie este arquivo para .env e preencha com seus valores

# ============================================================
# POSTGRESQL / PGVECTOR
# ============================================================
PG_USER=postgres
PG_PASSWORD=postgres
PG_HOST=localhost
PG_PORT=5432
PG_DB=vectordb

# ============================================================
# ELASTICSEARCH (Elastic Cloud ou Self-Hosted)
# ============================================================
# Para Elastic Cloud, use cloud_id:
ES_CLOUD_ID=seu-cluster:ZXUtd2VzdC0xLmF3cy5mb3VuZC5pbyRmNzI0...
ES_PASSWORD=senha-do-elastic

# OU para self-hosted (será ignorado se ES_CLOUD_ID estiver definido):
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=https
ES_USER=elastic
# ES_PASSWORD já definido acima

# ============================================================
# OPENSEARCH (Self-Hosted)
# ============================================================
OS_HOST=localhost
OS_PORT=9200
OS_USER=admin
OS_PASSWORD=admin

# ============================================================
# AWS OPENSEARCH
# ============================================================
AWS_OS_HOST=search-meu-cluster.us-east-1.es.amazonaws.com
AWS_OS_PORT=443
AWS_OS_USER=master-user
AWS_OS_PASSWORD=senha-segura
